<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Menu Setup - RMS SaaS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Bengali:wght@400;600&family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/styles.css">
</head>
<body>
  <div class="app-container">
    {{ template "sidebar" . }}
    
    <main class="main-view">
      <div class="page-header">
        <div class="page-title">
          <h2>Menu Setup</h2>
          <p>Organize dishes into categories, configure prices</p>
        </div>
        <div style="display: flex; gap: 12px;">
          <button class="btn btn-secondary" onclick="document.getElementById('add-category-modal').style.display='flex'">
            + New Category
          </button>
          <button class="btn btn-primary" onclick="document.getElementById('add-item-modal').style.display='flex'">
            + New Menu Item
          </button>
        </div>
      </div>

      <div class="grid grid-3">
        <!-- Categories List Card -->
        <div class="card" style="grid-column: span 1;">
          <h3 style="margin-bottom: 16px; border-bottom: 1px solid var(--border); padding-bottom: 8px;">Categories</h3>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 8px;">
            {{ range .Categories }}
              <li style="display: flex; justify-content: space-between; align-items: center; padding: 8px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--paper);">
                <span>{{ .Name }} <small style="color: var(--ink-dim);">({{ .SortOrder }})</small></span>
                <form action="/menu/categories/delete/{{ .ID }}" method="POST" onsubmit="return confirm('Are you sure you want to delete this category?')" style="margin: 0;">
                  <button type="submit" class="btn btn-secondary" style="min-height: 28px; height: 28px; min-width:28px; padding: 0 8px; font-size: 11px; color: var(--status-danger);">Delete</button>
                </form>
              </li>
            {{ else }}
              <li style="color: var(--ink-dim); text-align: center; padding: 16px;">No categories yet.</li>
            {{ end }}
          </ul>
        </div>

        <!-- Menu Items List Card -->
        <div class="card" style="grid-column: span 2;">
          <h3 style="margin-bottom: 16px; border-bottom: 1px solid var(--border); padding-bottom: 8px;">Menu Items</h3>
          <table class="data-table">
            <thead>
              <tr>
                <th>Item Name</th>
                <th>Category</th>
                <th class="text-right">Price (BDT)</th>
                <th>Status</th>
                <th class="text-right">Action</th>
              </tr>
            </thead>
            <tbody>
              {{ $categories := .Categories }}
              {{ range .MenuItems }}
                <tr>
                  <td style="font-weight: 500;">
                    {{ .Name }}
                    {{ if .Description }}
                      <br><small style="color: var(--ink-dim); font-weight: normal;">{{ .Description }}</small>
                    {{ end }}
                  </td>
                  <td>
                    {{ $catID := .CategoryID }}
                    {{ $found := false }}
                    {{ range $categories }}
                      {{ if isEqualStringPtr .ID $catID }}
                        {{ .Name }}
                        {{ $found = true }}
                      {{ end }}
                    {{ end }}
                    {{ if not $found }}<span style="color: var(--ink-dim);">Uncategorized</span>{{ end }}
                  </td>
                  <td class="text-right mono-num" style="font-weight: 600;">৳{{ formatPrice .Price }}</td>
                  <td>
                    {{ if .IsAvailable }}
                      <span style="color: var(--status-good); font-size: 12px; font-weight: 600;">Available</span>
                    {{ else }}
                      <span style="color: var(--status-danger); font-size: 12px; font-weight: 600;">Unavailable</span>
                    {{ end }}
                  </td>
                  <td class="text-right">
                    <form action="/menu/items/delete/{{ .ID }}" method="POST" onsubmit="return confirm('Are you sure you want to delete this menu item?')" style="margin: 0; display: inline-block;">
                      <button type="submit" class="btn btn-secondary" style="min-height: 32px; height: 32px; min-width: 44px; padding: 4px 8px; font-size: 12px; color: var(--status-danger);">Delete</button>
                    </form>
                  </td>
                </tr>
              {{ else }}
                <tr>
                  <td colspan="5" style="text-align: center; color: var(--ink-dim); padding: 24px;">No items on the menu yet. Click "+ New Menu Item" to add.</td>
                </tr>
              {{ end }}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Add Category Modal -->
      <div class="modal-backdrop" id="add-category-modal" style="display: none;">
        <div class="modal">
          <div class="modal-header">
            <h3>New Category</h3>
            <button class="btn btn-secondary" style="min-height:30px; min-width:30px; padding:0;" onclick="document.getElementById('add-category-modal').style.display='none'">X</button>
          </div>
          <form action="/menu/categories/add" method="POST">
            <div class="modal-body">
              <div class="form-group">
                <label class="form-label" for="cat-name">Category Name</label>
                <input class="form-control" type="text" id="cat-name" name="name" required placeholder="e.g. Appetizers, Main Course, Drinks">
              </div>
              <div class="form-group">
                <label class="form-label" for="cat-sort">Sort Order</label>
                <input class="form-control" type="number" id="cat-sort" name="sort_order" min="0" value="0">
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" onclick="document.getElementById('add-category-modal').style.display='none'">Cancel</button>
              <button type="submit" class="btn btn-primary">Add Category</button>
            </div>
          </form>
        </div>
      </div>

      <!-- Add Menu Item Modal -->
      <div class="modal-backdrop" id="add-item-modal" style="display: none;">
        <div class="modal">
          <div class="modal-header">
            <h3>New Menu Item</h3>
            <button class="btn btn-secondary" style="min-height:30px; min-width:30px; padding:0;" onclick="document.getElementById('add-item-modal').style.display='none'">X</button>
          </div>
          <form action="/menu/items/add" method="POST">
            <div class="modal-body">
              <div class="form-group">
                <label class="form-label" for="item-name">Item Name</label>
                <input class="form-control" type="text" id="item-name" name="name" required placeholder="e.g. Chicken Biryani, Garlic Naan">
              </div>
              <div class="form-group">
                <label class="form-label" for="item-desc">Description</label>
                <textarea class="form-control" id="item-desc" name="description" placeholder="Short description of ingredients/portions"></textarea>
              </div>
              <div class="grid grid-2" style="gap: 16px;">
                <div class="form-group">
                  <label class="form-label" for="item-price">Price (BDT)</label>
                  <input class="form-control" type="number" id="item-price" name="price" step="0.01" min="0" required placeholder="e.g. 350.00">
                </div>
                <div class="form-group">
                  <label class="form-label" for="item-cat">Category</label>
                  <select class="form-control" id="item-cat" name="category_id">
                    <option value="">Select Category</option>
                    {{ range .Categories }}
                      <option value="{{ .ID }}">{{ .Name }}</option>
                    {{ end }}
                  </select>
                </div>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" onclick="document.getElementById('add-item-modal').style.display='none'">Cancel</button>
              <button type="submit" class="btn btn-primary">Add Item</button>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
