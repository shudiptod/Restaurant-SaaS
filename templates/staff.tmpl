<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Restaurant Staff - RMS SaaS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Bengali:wght@400;600&family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/styles.css">
</head>
<body>
  <div class="app-container">
    {{ template "sidebar" . }}
    <main class="main-view">
      <div class="page-header">
        <div class="page-title">
          <h2>Restaurant Staff</h2>
          <p>Manage selectable waiter, cashier, and custom-title names</p>
        </div>
      </div>
      {{ if .Error }}<div class="login-error" role="alert">{{ .Error }}</div>{{ end }}
      {{ if .Notice }}<div class="card" role="status" style="padding: 12px 16px; border-color: var(--status-good);">{{ .Notice }}</div>{{ end }}

      <section class="card" style="margin-bottom: 24px;">
        <h3 style="margin-bottom: 16px;">Add staff member</h3>
        <form action="/staff/add" method="POST">
          <div class="form-group">
            <label class="form-label" for="staff-name">Name</label>
            <input class="form-control" id="staff-name" name="name" required maxlength="120">
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 20px; margin-bottom: 16px;">
            <label><input type="checkbox" name="is_waiter" value="true"> Waiter</label>
            <label><input type="checkbox" name="is_cashier" value="true"> Cashier</label>
          </div>
          <div class="form-group">
            <label class="form-label" for="staff-title">Custom title (optional)</label>
            <input class="form-control" id="staff-title" name="custom_title" maxlength="80" placeholder="e.g. Shift lead">
          </div>
          <button class="btn btn-primary" type="submit">Add staff member</button>
        </form>
      </section>

      <section>
        <div class="page-header" style="margin-bottom: 14px;">
          <div class="page-title"><h3>Staff list</h3><p>{{ len .Staff }} people</p></div>
        </div>
        <div class="card" style="overflow-x: auto;">
          <table class="data-table">
            <thead><tr><th>Name</th><th>Roles</th><th>Status</th><th class="text-right">Action</th></tr></thead>
            <tbody>
              {{ range .Staff }}
              <tr>
                <td style="font-weight: 600;">{{ .Name }}</td>
                <td>
                  {{ if .IsWaiter }}Waiter{{ end }}
                  {{ if and .IsWaiter .IsCashier }}, {{ end }}
                  {{ if .IsCashier }}Cashier{{ end }}
                  {{ if .CustomTitle }}{{ if or .IsWaiter .IsCashier }}, {{ end }}{{ .CustomTitle }}{{ end }}
                </td>
                <td>{{ if .IsActive }}Active{{ else }}Inactive{{ end }}</td>
                <td class="text-right">
                  <form action="/staff/{{ .ID }}/status" method="POST" style="margin: 0;">
                    {{ if .IsActive }}<input type="hidden" name="status" value="inactive"><button class="btn btn-secondary" type="submit">Deactivate</button>
                    {{ else }}<input type="hidden" name="status" value="active"><button class="btn btn-secondary" type="submit">Reactivate</button>{{ end }}
                  </form>
                </td>
              </tr>
              {{ else }}<tr><td colspan="4" style="text-align: center; color: var(--ink-dim); padding: 20px;">No staff members yet.</td></tr>{{ end }}
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>
</body>
</html>