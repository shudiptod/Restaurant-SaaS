<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Restaurant Management SaaS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/styles.css">
  <style>
    body {
      background-color: #FBFAF7; /* --paper */
    }
  </style>
</head>
<body class="login-body">
  <div class="card login-card">
    <div class="login-header">
      <h2>RMS Login</h2>
      <p>Enter your details to manage your restaurants</p>
    </div>
    
    {{ if .Error }}
    <div class="login-error">
      {{ .Error }}
    </div>
    {{ end }}
    
    <form action="/login" method="POST">
      <div class="form-group">
        <label class="form-label" for="email">Email Address</label>
        <input class="form-control" type="email" id="email" name="email" required placeholder="owner@example.com">
      </div>
      
      <div class="form-group" style="margin-bottom: 24px;">
        <label class="form-label" for="password">Password</label>
        <input class="form-control" type="password" id="password" name="password" required placeholder="••••••••">
      </div>
      
      <button class="btn btn-primary" type="submit" style="width: 100%;">
        Sign In
      </button>
    </form>
    
    <div style="margin-top: 24px; text-align: center; font-size: 13px; color: var(--ink-dim);">
      <p>Dev Mode: credentials <strong>owner@example.com</strong> / <strong>password</strong></p>
    </div>
  </div>
</body>
</html>
